<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.payments.trade.service.mapper.PaymentCallbackRecordMapper">
  <resultMap id="CallbackResultMap" type="com.example.payments.trade.service.model.PaymentCallbackRecordEntity">
    <id property="id" column="id"/>
    <result property="callbackId" column="callback_id"/>
    <result property="attemptId" column="attempt_id"/>
    <result property="channelOrderId" column="channel_order_id"/>
    <result property="rawPayload" column="raw_payload"/>
    <result property="signature" column="signature"/>
    <result property="status" column="status"/>
    <result property="receivedAt" column="received_at"/>
    <result property="processedAt" column="processed_at"/>
  </resultMap>
  <select id="findByCallbackId" resultMap="CallbackResultMap">
    SELECT * FROM payment_callback_record WHERE callback_id = #{callbackId} LIMIT 1
  </select>
</mapper>
