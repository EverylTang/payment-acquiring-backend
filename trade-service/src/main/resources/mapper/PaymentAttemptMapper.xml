<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.payments.trade.service.infrastructure.persistence.PaymentAttemptMapper">
  <resultMap id="AttemptResultMap" type="com.example.payments.trade.service.infrastructure.persistence.PaymentAttemptEntity">
    <id property="id" column="id" />
    <result property="attemptId" column="attempt_id" />
    <result property="orderId" column="order_id" />
    <result property="channelId" column="channel_id" />
    <result property="channelRequestNo" column="channel_request_no" />
    <result property="attemptNo" column="attempt_no" />
    <result property="status" column="status" />
    <result property="requestSummary" column="request_summary" />
    <result property="responseSummary" column="response_summary" />
    <result property="failureCode" column="failure_code" />
    <result property="startedAt" column="started_at" />
    <result property="completedAt" column="completed_at" />
    <result property="version" column="version" />
  </resultMap>
  <select id="findProcessingBefore" resultMap="AttemptResultMap">
    SELECT * FROM payment_attempt WHERE status = 'PROCESSING' AND started_at &lt;= #{before}
  </select>
  <select id="findByChannelOrderId" resultMap="AttemptResultMap">
    SELECT * FROM payment_attempt WHERE channel_request_no = #{channelOrderId} LIMIT 1
  </select>
  <select id="countByOrderId" resultType="int">
    SELECT COUNT(*) FROM payment_attempt WHERE order_id = #{orderId}
  </select>
  <update id="updateAttempt">
    UPDATE payment_attempt
    SET status = #{next}, response_summary = #{responseSummary}, failure_code = #{failureCode},
        completed_at = #{completedAt}, version = version + 1
    WHERE attempt_id = #{attemptId} AND status = #{expected}
  </update>
</mapper>
