<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.payments.platform.service.mapper.ProductCapabilityMapper">
  <resultMap id="CapabilityMap" type="com.example.payments.platform.service.model.ProductCapabilityModel">
    <id property="capabilityId" column="capability_id" />
    <result property="productCode" column="product_code" />
    <result property="country" column="country" />
    <result property="currency" column="currency" />
    <result property="paymentMethod" column="payment_method" />
    <result property="minAmount" column="min_amount" />
    <result property="maxAmount" column="max_amount" />
    <result property="supportsRefund" column="supports_refund" />
    <result property="status" column="status" />
  </resultMap>
  <sql id="columns">
    capability_id,product_code,country,currency,payment_method,min_amount,max_amount,supports_refund,status
  </sql>
  <select id="countByProduct" resultType="long">
    SELECT COUNT(*)
    FROM product_capability
    WHERE product_code=#{productCode}
  </select>
  <select id="selectPageByProduct" resultMap="CapabilityMap">
    SELECT
    <include refid="columns" />
    FROM product_capability
    WHERE product_code=#{productCode}
    ORDER BY id
    LIMIT #{limit}
    OFFSET #{offset}
  </select>
  <select id="selectById" resultMap="CapabilityMap">
    SELECT
    <include refid="columns" />
    FROM product_capability
    WHERE capability_id=#{capabilityId}
  </select>
  <insert id="insertCapability">
    INSERT INTO product_capability(capability_id,product_code,country,currency,payment_method,min_amount,max_amount,supports_refund,status)
    VALUES(#{id},#{productCode},#{country},#{currency},#{paymentMethod},#{minAmount},#{maxAmount},#{supportsRefund},'ACTIVE')
  </insert>
  <update id="updateCapability">
    UPDATE product_capability
    SET country=#{country},currency=#{currency},payment_method=#{paymentMethod},min_amount=#{minAmount},max_amount=#{maxAmount},supports_refund=#{supportsRefund}
    WHERE capability_id=#{id}
    AND product_code=#{productCode}
  </update>
  <update id="updateStatus">
    UPDATE product_capability
    SET status=#{status}
    WHERE capability_id=#{id}
    AND product_code=#{productCode}
  </update>
</mapper>
