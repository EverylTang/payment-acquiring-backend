<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.payments.platform.service.mapper.ProductCapabilityMapper">
  <resultMap id="CapabilityMap" type="com.example.payments.platform.service.model.ProductCapabilityModel">
    <constructor>
      <idArg column="capability_id" javaType="java.lang.String" />
      <arg column="product_code" javaType="java.lang.String" />
      <arg column="customer_payment_method" javaType="java.lang.String" />
      <arg column="channel_payment_method" javaType="java.lang.String" />
      <arg column="min_amount" javaType="java.math.BigDecimal" />
      <arg column="max_amount" javaType="java.math.BigDecimal" />
      <arg column="supports_refund" javaType="boolean" />
      <arg column="status" javaType="java.lang.String" />
    </constructor>
  </resultMap>
  <sql id="columns">
    capability_id,product_code,customer_payment_method,channel_payment_method,min_amount,max_amount,supports_refund,status
  </sql>
  <select id="countByProduct" resultType="long">
    SELECT COUNT(*)
    FROM product_capability
    WHERE product_code=#{productCode}
  </select>
  <select id="selectPageByProduct" resultMap="CapabilityMap">
    SELECT
    <include refid="columns" />
    FROM product_capability
    WHERE product_code=#{productCode}
    ORDER BY id
    LIMIT #{limit}
    OFFSET #{offset}
  </select>
  <select id="selectById" resultMap="CapabilityMap">
    SELECT
    <include refid="columns" />
    FROM product_capability
    WHERE capability_id=#{capabilityId}
  </select>
  <insert id="insertCapability">
    INSERT INTO product_capability(capability_id,product_code,customer_payment_method,channel_payment_method,min_amount,max_amount,supports_refund,status)
    VALUES(#{id},#{productCode},#{customerPaymentMethod},#{channelPaymentMethod},#{minAmount},#{maxAmount},#{supportsRefund},'ACTIVE')
  </insert>
  <update id="updateCapability">
    UPDATE product_capability
    SET customer_payment_method=#{customerPaymentMethod},channel_payment_method=#{channelPaymentMethod},min_amount=#{minAmount},max_amount=#{maxAmount},supports_refund=#{supportsRefund}
    WHERE capability_id=#{id}
    AND product_code=#{productCode}
  </update>
  <update id="updateStatus">
    UPDATE product_capability
    SET status=#{status}
    WHERE capability_id=#{id}
    AND product_code=#{productCode}
  </update>
  <delete id="deleteCapability">
    DELETE FROM product_capability
    WHERE capability_id=#{id}
    AND product_code=#{productCode}
  </delete>
</mapper>
