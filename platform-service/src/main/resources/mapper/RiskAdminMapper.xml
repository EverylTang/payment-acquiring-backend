<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.payments.platform.service.mapper.RiskAdminMapper">
  <resultMap id="event" type="com.example.payments.platform.service.service.RiskAdminService$RiskEventRow"><constructor><arg column="event_id"/><arg column="order_id"/><arg column="merchant_id"/><arg column="policy_id"/><arg column="policy_name"/><arg column="decision"/><arg column="risk_level"/><arg column="status"/><arg column="reason"/><arg column="subject_type"/><arg column="subject_masked"/><arg column="reviewer"/><arg column="review_decision"/><arg column="review_note"/><arg column="created_at" javaType="java.time.Instant"/><arg column="resolved_at" javaType="java.time.Instant"/></constructor></resultMap>
  <resultMap id="list" type="com.example.payments.platform.service.service.RiskAdminService$RiskListRow"><constructor><arg column="entry_id"/><arg column="list_type"/><arg column="subject_type"/><arg column="subject_hash"/><arg column="label"/><arg column="expires_at" javaType="java.time.Instant"/><arg column="status"/><arg column="created_by"/><arg column="created_at" javaType="java.time.Instant"/></constructor></resultMap>
  <sql id="eventWhere"><where><if test="status != null">AND status=#{status}</if><if test="level != null">AND risk_level=#{level}</if><if test="merchantId != null">AND merchant_id=#{merchantId}</if></where></sql>
  <select id="countEvents" resultType="long">SELECT COUNT(*) FROM risk_event <include refid="eventWhere"/></select>
  <select id="selectEvents" resultMap="event">SELECT event_id,order_id,merchant_id,policy_id,policy_name,decision,risk_level,status,reason,subject_type,subject_masked,reviewer,review_decision,review_note,created_at,resolved_at FROM risk_event <include refid="eventWhere"/> ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}</select>
  <select id="selectEvent" resultMap="event">SELECT event_id,order_id,merchant_id,policy_id,policy_name,decision,risk_level,status,reason,subject_type,subject_masked,reviewer,review_decision,review_note,created_at,resolved_at FROM risk_event WHERE event_id=#{eventId}</select>
  <select id="countOpenEvents" resultType="long">SELECT COUNT(*) FROM risk_event WHERE status='OPEN'</select><select id="countReviewEvents" resultType="long">SELECT COUNT(*) FROM risk_event WHERE decision='REVIEW' AND status!='RESOLVED'</select><select id="countRejectedEvents" resultType="long">SELECT COUNT(*) FROM risk_event WHERE review_decision='REJECT' OR decision='REJECT'</select><select id="countEventsSince" resultType="long">SELECT COUNT(*) FROM risk_event WHERE created_at >= #{since}</select>
  <update id="resolveEvent">UPDATE risk_event SET status='RESOLVED',reviewer=#{operator},review_decision=#{decision},review_note=#{note},resolved_at=#{now} WHERE event_id=#{eventId}</update>
  <insert id="upsertCase">INSERT INTO risk_case(case_id,event_id,status,assignee,decision,note,created_at,updated_at) VALUES(#{caseId},#{eventId},'CLOSED',#{operator},#{decision},#{note},#{now},#{now}) ON DUPLICATE KEY UPDATE status='CLOSED',assignee=#{operator},decision=#{decision},note=#{note},updated_at=#{now}</insert>
  <sql id="listWhere"><where><if test="listType != null">AND list_type=#{listType}</if></where></sql><select id="countLists" resultType="long">SELECT COUNT(*) FROM risk_list_entry <include refid="listWhere"/></select><select id="selectLists" resultMap="list">SELECT entry_id,list_type,subject_type,subject_hash,label,expires_at,status,created_by,created_at FROM risk_list_entry <include refid="listWhere"/> ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}</select>
  <insert id="insertList">INSERT INTO risk_list_entry(entry_id,list_type,subject_type,subject_hash,label,expires_at,status,created_by,created_at,updated_at) VALUES(#{entryId},#{listType},#{subjectType},#{subjectHash},#{label},#{expiresAt},'ACTIVE',#{operator},#{now},#{now})</insert><update id="updateListStatus">UPDATE risk_list_entry SET status=#{status},updated_at=#{now} WHERE entry_id=#{entryId}</update>
  <insert id="insertEvent">INSERT INTO risk_event(event_id,order_id,merchant_id,policy_id,policy_name,decision,risk_level,status,reason,subject_type,subject_masked,created_at) VALUES(#{eventId},#{orderId},#{merchantId},#{policyId},#{policyName},#{decision},#{riskLevel},'OPEN',#{reason},#{subjectType},#{subjectMasked},#{now})</insert>
</mapper>
