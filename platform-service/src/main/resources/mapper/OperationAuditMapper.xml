<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.payments.platform.service.mapper.OperationAuditMapper">
  <insert id="insertAudit">
    INSERT INTO operation_audit(audit_id,operator_id,action,resource_type,resource_id,after_summary,created_at)
    VALUES(#{auditId},#{operator},#{action},#{resourceType},#{resourceId},#{summary},#{createdAt})
  </insert>
  <insert id="insertAuditWithoutSummary">
    INSERT INTO operation_audit(audit_id,operator_id,action,resource_type,resource_id,created_at)
    VALUES(#{auditId},#{operator},#{action},#{resourceType},#{resourceId},#{createdAt})
  </insert>
  <insert id="insertAuditWithReason">
    INSERT INTO operation_audit(audit_id,operator_id,action,resource_type,resource_id,reason,after_summary,created_at)
    VALUES(#{auditId},#{operator},#{action},#{resourceType},#{resourceId},#{reason},#{summary},#{createdAt})
  </insert>
</mapper>
